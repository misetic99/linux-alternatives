{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alternative.schema.json",
  "title": "Linux alternative",
  "description": "One application that runs on Linux. File: data/alternatives/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "homepage", "license", "install"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "license": {
      "description": "SPDX license identifier, or \"proprietary\".",
      "type": "string",
      "minLength": 1
    },
    "description": { "type": "string", "maxLength": 300 },
    "install": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "ref"],
        "properties": {
          "method": { "enum": ["apt", "dnf", "pacman", "flatpak", "snap", "appimage", "download"] },
          "ref": {
            "description": "Package name, Flatpak app ID, or download URL.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
